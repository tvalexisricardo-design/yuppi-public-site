# --- CMS / Supabase ---
# Create a Supabase project and run supabase-schema.sql in SQL Editor.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
# Compatibilidade temporária: a chave legacy também é aceite se ainda a estiveres a usar.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# --- Admin ---
# Basic Auth credentials for /admin. Use a long random password in production.
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# --- Google AdSense ---
# Keep empty while the site is under review / before AdSense is configured.
# Example after approval: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional fixed ad slot. Leave blank to use responsive/Auto Ads.
NEXT_PUBLIC_ADSENSE_SLOT=
